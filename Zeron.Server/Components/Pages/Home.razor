@page "/"
@rendermode InteractiveServer
@using Zeron.Server.ZServers
@using Zeron.ZCore.Type
@attribute [Authorize(Policy = ServerPolicies.ViewerOrAbove)]
@inject DashboardSummaryServer DashboardSummaryServer
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@implements IAsyncDisposable

<div class="page-header">
    <div>
        <h1>Dashboard</h1>
        <p>Operational summary of agents, catalog sync, tasks, alerts, and events.</p>
    </div>
    <div class="actions">
        <button class="btn btn-secondary" @onclick="ReloadAsync" disabled="@m_IsLoading">Refresh</button>
        <AuthorizeView Roles="@($"{ServerRoles.Admin},{ServerRoles.Operator}")">
            <Authorized>
                <a class="btn" href="/tasks/create">Create Task</a>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@if (m_PasswordChanged)
{
    <p class="success-text">Password updated successfully.</p>
}

@if (m_Summary == null)
{
    <div class="panel"><p>Loading dashboard...</p></div>
}
else
{
    <div class="panel security-panel">
        <div class="panel-header">
            <h2>Transport Security</h2>
            <span class="status @m_Summary.Security.OverallStatus">@m_Summary.Security.OverallStatus</span>
        </div>
        <div class="security-grid">
            <div class="security-item">
                <span>NetMQ CURVE</span>
                <strong>
                    <span class="status @(m_Summary.Security.CurveEnabled ? "healthy" : "warning")">
                        @(m_Summary.Security.CurveEnabled ? "enabled" : "off")
                    </span>
                </strong>
                @if (m_Summary.Security.CurveEnabled)
                {
                    <small>public key @(m_Summary.Security.CurvePublicKeyPresent ? "present" : "missing")</small>
                }
                else
                {
                    <small>command channel plaintext</small>
                }
            </div>
            <div class="security-item">
                <span>Agent HTTP HMAC</span>
                <strong>
                    <span class="status @(m_Summary.Security.AgentHmacRequired ? "healthy" : "warning")">
                        @(m_Summary.Security.AgentHmacRequired ? "required" : "optional")
                    </span>
                </strong>
                <small>heartbeat / events / results</small>
            </div>
            <div class="security-item">
                <span>HTTPS for Agents</span>
                <strong>
                    <span class="status @(m_Summary.Security.RequireHttpsAgents ? "healthy" : "warning")">
                        @(m_Summary.Security.RequireHttpsAgents ? "required" : "not enforced")
                    </span>
                </strong>
                <small>or reverse-proxy TLS</small>
            </div>
        </div>
        @if (m_Summary.Security.Recommendations.Count > 0)
        {
            <ul class="security-recommendations">
                @foreach (string tip in m_Summary.Security.Recommendations)
                {
                    <li>@tip</li>
                }
            </ul>
        }
        else
        {
            <p class="muted" style="margin-top: 0.75rem; margin-bottom: 0;">
                CURVE and HMAC are enabled. Ensure agents have matching <code>zmq_sub_curve_*</code> and <code>server_hmac_enabled</code>.
            </p>
        }
    </div>

    <div class="cards">
        <a class="card card-link" href="/agents">
            <span>Agents Online</span>
            <strong class="text-success">@m_Summary.AgentsOnline</strong>
            <small>@m_Summary.AgentsTotal total</small>
        </a>
        <a class="card card-link" href="/agents">
            <span>Agents Offline</span>
            <strong class="@(m_Summary.AgentsOffline > 0 ? "text-danger" : "")">@m_Summary.AgentsOffline</strong>
            <small>@m_Summary.AgentsDisabled disabled</small>
        </a>
        <a class="card card-link" href="/agents">
            <span>Connection Stale</span>
            <strong class="@(m_Summary.AgentsStale > 0 ? "text-warning" : "")">@m_Summary.AgentsStale</strong>
            <small>heartbeat aging</small>
        </a>
        <a class="card card-link" href="/packages/sync-health">
            <span>Catalog Sync Unhealthy</span>
            <strong class="@(m_Summary.CatalogSyncUnhealthy > 0 ? "text-warning" : "")">@m_Summary.CatalogSyncUnhealthy</strong>
            <small>@m_Summary.CatalogSyncHealthy healthy · @m_Summary.CatalogSyncOffline offline</small>
        </a>
        <a class="card card-link" href="/events?topic=install.">
            <span>Unread Install Tips</span>
            <strong class="@(m_Summary.UnreadInstallFailures > 0 ? "text-danger" : m_Summary.UnreadInstallNotifications > 0 ? "text-warning" : "")">@m_Summary.UnreadInstallNotifications</strong>
            <small>@m_Summary.UnreadInstallFailures failed · DeviceOwner inbox</small>
        </a>
        <a class="card card-link" href="/tasks">
            <span>Active Tasks</span>
            <strong>@m_Summary.ActiveTasks</strong>
            <small>pending / running</small>
        </a>
        <a class="card card-link" href="/alerts">
            <span>Open Alerts</span>
            <strong class="@(m_Summary.OpenAlerts > 0 ? "text-warning" : "")">@m_Summary.OpenAlerts</strong>
            <small>needs attention</small>
        </a>
        <a class="card card-link" href="/events">
            <span>Recent Events</span>
            <strong>@m_Summary.RecentEvents.Count</strong>
            <small>latest feed</small>
        </a>
    </div>

    <div class="dashboard-grid">
        <div class="panel">
            <div class="panel-header">
                <h2>Open Alerts</h2>
                <a href="/alerts">View all</a>
            </div>
            @if (m_Summary.RecentAlerts.Count == 0)
            {
                <p class="muted">No open alerts.</p>
            }
            else
            {
                @foreach (DashboardAlertItemType alert in m_Summary.RecentAlerts)
                {
                    <div class="timeline-item">
                        <strong>@alert.Title</strong>
                        <small>
                            <span class="status @alert.Severity">@alert.Severity</span>
                            @(alert.AgentKey ?? "system") · @UiFormatServer.FormatTime(alert.CreatedAt)
                        </small>
                        <div>@UiFormatServer.Truncate(alert.Message, 140)</div>
                    </div>
                }
            }
        </div>

        <div class="panel">
            <div class="panel-header">
                <h2>Recent Tasks</h2>
                <a href="/tasks">View all</a>
            </div>
            @if (m_Summary.RecentTasks.Count == 0)
            {
                <p class="muted">No tasks yet.</p>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>API</th>
                            <th>Status</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (DashboardTaskItemType task in m_Summary.RecentTasks)
                        {
                            <tr>
                                <td><a href="@($"/tasks/{task.Id}")">@task.Name</a></td>
                                <td>@task.TargetApi</td>
                                <td><span class="status @task.Status">@task.Status</span></td>
                                <td>@UiFormatServer.FormatTime(task.CreatedAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="dashboard-grid">
        <div class="panel">
            <div class="panel-header">
                <h2>Agents</h2>
                <a href="/agents">View all</a>
            </div>
            @if (m_Summary.RecentAgents.Count == 0)
            {
                <p class="muted">No agents registered. Start Zeron.Demand with server_enabled=true.</p>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>Agent</th>
                            <th>Host</th>
                            <th>Status</th>
                            <th>Connection</th>
                            <th>Heartbeat</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (DashboardAgentItemType agent in m_Summary.RecentAgents)
                        {
                            <tr>
                                <td><a href="@($"/agents/{agent.AgentKey}")">@agent.AgentKey</a></td>
                                <td>@(agent.MachineName ?? "-")</td>
                                <td><span class="status @agent.Status">@agent.Status</span></td>
                                <td><span class="status @agent.ConnectionState">@agent.ConnectionState</span></td>
                                <td>@UiFormatServer.FormatHeartbeat(agent.LastHeartbeatAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="panel">
            <div class="panel-header">
                <h2>Recent Events</h2>
                <a href="/events">View all</a>
            </div>
            @if (m_Summary.RecentEvents.Count == 0)
            {
                <p class="muted">No events received yet.</p>
            }
            else
            {
                @foreach (DashboardEventItemType evt in m_Summary.RecentEvents)
                {
                    <div class="timeline-item">
                        <strong>@evt.Topic</strong>
                        <small>@(evt.AgentKey ?? "-") · @UiFormatServer.FormatTime(evt.ReceivedAt)</small>
                        <div>@UiFormatServer.Truncate(evt.Payload, 120)</div>
                    </div>
                }
            }
        </div>
    </div>

    <p class="muted"><small>Updated @UiFormatServer.FormatTime(m_Summary.GeneratedAtUtc)</small></p>
}
