@page "/account/change-password"
@layout EmptyLayout
@attribute [Authorize(Policy = ServerPolicies.DeviceOwnerOrStaff)]

<div class="login-page">
    <div class="login-card">
        <div class="brand" style="margin-bottom: 1.5rem;">
            <span class="brand-mark">Z</span>
            <div>
                <strong>Change Password</strong>
                <small>@(m_IsRequired ? "Required before continuing" : "Update your account password")</small>
            </div>
        </div>

        @if (m_IsRequired)
        {
            <p class="warning-text">You must set a new password before using the dashboard.</p>
        }

        <form method="post" action="/account/change-password">
            <div class="form-grid">
                <label>
                    Current Password
                    <input name="currentPassword" type="password" required autocomplete="current-password" />
                    @if (!string.IsNullOrWhiteSpace(m_CurrentPasswordError))
                    {
                        <p class="field-error">@m_CurrentPasswordError</p>
                    }
                </label>
                <label>
                    New Password
                    <input name="newPassword" type="password" required minlength="6" autocomplete="new-password" />
                    @if (!string.IsNullOrWhiteSpace(m_NewPasswordError))
                    {
                        <p class="field-error">@m_NewPasswordError</p>
                    }
                </label>
                <label>
                    Confirm New Password
                    <input name="confirmPassword" type="password" required minlength="6" autocomplete="new-password" />
                    @if (!string.IsNullOrWhiteSpace(m_ConfirmPasswordError))
                    {
                        <p class="field-error">@m_ConfirmPasswordError</p>
                    }
                </label>
                <button class="btn" type="submit">Update Password</button>
            </div>
        </form>

        @if (!string.IsNullOrWhiteSpace(m_Error))
        {
            <NotificationBanner Success="false" Message="m_Error" />
        }

        @if (!m_IsRequired)
        {
            <p style="margin-top: 1rem;"><a href="/account">Back to Account</a></p>
        }
        else
        {
            <form method="post" action="/account/logout" style="margin-top: 1rem;">
                <button class="btn-link" type="submit">Logout</button>
            </form>
        }
    </div>
</div>
