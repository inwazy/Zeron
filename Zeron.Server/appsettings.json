{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Zeron": {
    "DatabasePath": "Data/zeron-server.db",
    "CommandPubAddr": "tcp://*:6000",
    "AgentApiKey": "zeron.testkey",
    "HeartbeatTimeoutSeconds": 90,
    "DispatchIntervalMs": 5000,
    "JwtSecret": "zeron-dev-secret-change-in-production",
    "JwtIssuer": "Zeron.Server",
    "JwtExpireMinutes": 480,
    "DefaultAdminUsername": "admin",
    "DefaultAdminPassword": "admin",
    "AlertEmailEnabled": false,
    "AlertEmailTo": "",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUser": "",
    "SmtpPassword": "",
    "SmtpFrom": "zeron@localhost",
    "SmtpEnableSsl": true
  },
  "Urls": "http://localhost:5000"
}
