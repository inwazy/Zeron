@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using System.Reflection
@using Zeron.Server.Components.Shared
@using Zeron.Server.ZInterfaces
@inject IEnumerable<INavMenuContribution> NavContributions

<nav class="nav-menu" aria-label="Main navigation">
    <AuthorizeView Roles="@($"{ServerRoles.Admin},{ServerRoles.Operator},{ServerRoles.Viewer}")">
        <Authorized>
            <NavLink href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
            <NavLink href="/agents">Agents</NavLink>
            <NavLink href="/tasks">Tasks</NavLink>
            <NavLink href="/schedules">Schedules</NavLink>
            <div class="nav-section">
                <span class="nav-section-label">Packages</span>
                <NavLink href="/packages">Deploys</NavLink>
                <NavLink href="/packages/catalog" class="nav-nested">Catalog</NavLink>
                <NavLink href="/packages/sync-health" class="nav-nested">Sync Health</NavLink>
            </div>
            <NavLink href="/events">Events</NavLink>
            <NavLink href="/audit">Audit</NavLink>
            <NavLink href="/alerts">Alerts</NavLink>
            @foreach (NavMenuItem item in NavContributions.SelectMany(contribution => contribution.GetItems()))
            {
                <NavLink href="@item.Href">@item.Text</NavLink>
            }
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Roles="@ServerRoles.DeviceOwner">
        <Authorized>
            <div class="nav-section">
                <span class="nav-section-label">Portal</span>
                <NavLink href="/my-devices">My Devices</NavLink>
            </div>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Roles="@ServerRoles.Admin">
        <Authorized>
            <div class="nav-section">
                <span class="nav-section-label">Administration</span>
                <NavLink href="/users">Users</NavLink>
                <NavLink href="/device-bindings">Device Bindings</NavLink>
            </div>
        </Authorized>
    </AuthorizeView>
</nav>

<AuthorizeView>
    <Authorized>
        <div class="nav-user">
            <span>@context.User.Identity?.Name</span>
            <small>@GetRole(context.User)</small>
            <a class="btn-link" href="/account">Account</a>
            <button class="btn-link" type="button" @onclick="OpenAbout">About</button>
            <form method="post" action="/account/logout">
                <button class="btn-link" type="submit">Logout</button>
            </form>
        </div>
    </Authorized>
</AuthorizeView>

@if (m_ShowAbout)
{
    <div class="modal-backdrop" @onclick="CloseAbout" @onkeydown="OnAboutKeyDown">
        <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="about-title" tabindex="-1" @onclick:stopPropagation="true" @ref="m_AboutPanel">
            <div class="modal-header">
                <h2 id="about-title">About Zeron</h2>
                <button class="btn-link" type="button" @onclick="CloseAbout" aria-label="Close">Close</button>
            </div>
            <div class="modal-body">
                <p class="about-org">Inwazy Technology</p>
                <p><a href="https://inwazy.com" target="_blank" rel="noopener noreferrer">https://inwazy.com</a></p>
                <hr class="about-divider" />
                <p class="about-author">Jiowcl — Ji-Feng Tsai</p>
                <p><a href="mailto:jiowcl@gmail.com">jiowcl@gmail.com</a></p>
                <p class="muted about-version">Zeron.Server @m_Version</p>
            </div>
        </div>
    </div>
}
