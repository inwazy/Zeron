@page "/packages/deploy"
@rendermode InteractiveServer
@using Zeron.Server.ZServers
@using Zeron.ZCore.Type
@attribute [Authorize(Policy = ServerPolicies.OperatorOrAbove)]
@inject PackageDeployServer PackageDeployServer
@inject ManagedPackageCatalogServer CatalogServer
@inject NavigationManager Navigation

<div class="page-header">
    <div>
        <h1>Deploy Package</h1>
        <p>Dispatch ManagedPackage install or uninstall to selected agents.</p>
    </div>
</div>

<div class="panel">
    <div class="form-grid">
        <label>
            Operation
            <InputSelect @bind-Value="m_Model.Operation">
                <option value="install">Install</option>
                <option value="uninstall">Uninstall</option>
            </InputSelect>
        </label>
        <label>
            Package
            <InputSelect @bind-Value="m_Model.PackageName">
                <option value="">Select package</option>
                @foreach (ManagedPackageInfoType package in m_Packages)
                {
                    <option value="@package.Name">@package.Name</option>
                }
            </InputSelect>
            <small class="muted">From the Server catalog. Agents sync this list (local overrides are preserved).</small>
        </label>
        <label>
            Extra Args
            <InputText @bind-Value="m_Model.ExtraArgs" />
            <small class="muted">Optional. Appended to the package install/uninstall command.</small>
        </label>
        <label>
            Task Name
            <InputText @bind-Value="m_Model.Name" />
            <small class="muted">Optional. Auto-generated if empty.</small>
        </label>
        <label>
            Target Type
            <InputSelect @bind-Value="m_Model.TargetType">
                <option value="all">All Online Agents</option>
                <option value="agent">Specific Agent</option>
                <option value="filter">Hostname Filter</option>
            </InputSelect>
        </label>
        @if (m_Model.TargetType == "agent")
        {
            <label>
                Agent Id
                <InputText @bind-Value="m_Model.AgentId" />
            </label>
        }
        @if (m_Model.TargetType == "filter")
        {
            <label>
                Hostname Pattern
                <InputText @bind-Value="m_Model.HostnamePattern" />
            </label>
        }
        <div class="actions">
            <button class="btn" @onclick="HandleDeployAsync" disabled="@m_IsSubmitting">Deploy</button>
            <a class="btn btn-secondary" href="/packages">Cancel</a>
            <a class="btn btn-secondary" href="/packages/catalog">Catalog</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(m_CommandPreview))
    {
        <p class="muted" style="margin-top: 1rem;">
            Command preview: <code>ManagedPackage @m_CommandPreview</code>
        </p>
    }

    @if (!string.IsNullOrWhiteSpace(m_Error))
    {
        <p class="error">@m_Error</p>
    }

    @if (m_Packages.Count == 0)
    {
        <p class="error" style="margin-top: 1rem;">No enabled packages in the catalog. Add one under Package Catalog first.</p>
    }
</div>

<div class="panel">
    <h2>How it works</h2>
    <ol class="help-list">
        <li>Server creates a task with <code>TargetApi=ManagedPackage</code>.</li>
        <li>Agent queues the package locally and returns <code>queued:true</code>.</li>
        <li>Install progress is reported as <code>install.started</code>, <code>install.completed</code>, or <code>install.failed</code> events.</li>
    </ol>
</div>
