@page "/users"
@rendermode InteractiveServer
@using Zeron.Server.ZCore
@using Zeron.Server.ZCore.Type
@using Zeron.Server.ZServers
@attribute [Authorize(Policy = ServerPolicies.AdminOnly)]
@inject UserManagerServer UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="page-header">
    <div>
        <h1>Users</h1>
        <p>Manage dashboard accounts and roles.</p>
    </div>
</div>

<div class="panel">
    <h2>Create User</h2>
    <div class="form-grid">
        <label>
            Username
            <InputText @bind-Value="m_CreateModel.Username" />
        </label>
        <label>
            Password
            <InputText type="password" @bind-Value="m_CreateModel.Password" />
        </label>
        <label>
            Role
            <InputSelect @bind-Value="m_CreateModel.Role">
                <option value="@ServerRoles.Viewer">Viewer</option>
                <option value="@ServerRoles.Operator">Operator</option>
                <option value="@ServerRoles.Admin">Admin</option>
                <option value="@ServerRoles.DeviceOwner">DeviceOwner</option>
            </InputSelect>
        </label>
        <label>
            Email (optional)
            <InputText @bind-Value="m_CreateModel.Email" />
        </label>
        <div class="actions">
            <LoadingButton CssClass="btn"
                            Text="Create User"
                            IsLoading="@m_IsBusy"
                            OnClick="CreateUserAsync" />
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(m_CreateMessage))
    {
        <NotificationBanner Success="m_CreateSucceeded" Message="m_CreateMessage" />
    }
</div>

<div class="panel">
    <h2>Existing Users</h2>
    @if (m_Rows.Count == 0)
    {
        <p>No users found.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Role</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Password</th>
                    <th>Created</th>
                    <th>Reset Password</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (UserEditRowType row in m_Rows)
                {
                    <tr>
                        <td>@row.Username</td>
                        <td>
                            <InputSelect @bind-Value="row.Role" disabled="@m_IsBusy">
                                <option value="@ServerRoles.Viewer">Viewer</option>
                                <option value="@ServerRoles.Operator">Operator</option>
                                <option value="@ServerRoles.Admin">Admin</option>
                                <option value="@ServerRoles.DeviceOwner">DeviceOwner</option>
                            </InputSelect>
                        </td>
                        <td>
                            <InputText @bind-Value="row.Email"
                                       placeholder="notify@example.com"
                                       disabled="@m_IsBusy" />
                        </td>
                        <td>
                            <span class="status @(row.IsActive ? "online" : "offline")">
                                @(row.IsActive ? "active" : "inactive")
                            </span>
                        </td>
                        <td>
                            @if (row.MustChangePassword)
                            {
                                <span class="status stale">must change</span>
                            }
                            else
                            {
                                <span class="status healthy">ok</span>
                            }
                        </td>
                        <td>@(row.CreatedAt?.ToLocalTime().ToString("g") ?? "-")</td>
                        <td>
                            <InputText type="password"
                                       @bind-Value="row.NewPassword"
                                       placeholder="New password"
                                       disabled="@m_IsBusy" />
                        </td>
                        <td>
                            <div class="actions">
                                <LoadingButton CssClass="btn btn-secondary"
                                                Text="Save"
                                                IsLoading="@m_IsBusy"
                                                OnClick="() => SaveUserAsync(row)" />
                                @if (row.IsActive)
                                {
                                    <LoadingButton CssClass="btn btn-danger"
                                                    Text="Deactivate"
                                                    IsLoading="@m_IsBusy"
                                                    Disabled="@(m_IsBusy || row.Id == m_CurrentUserId)"
                                                    OnClick="() => SetActiveAsync(row, false)" />
                                }
                                else
                                {
                                    <LoadingButton CssClass="btn btn-secondary"
                                                    Text="Activate"
                                                    IsLoading="@m_IsBusy"
                                                    Disabled="@m_IsBusy"
                                                    OnClick="() => SetActiveAsync(row, true)" />
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (!string.IsNullOrWhiteSpace(m_UpdateMessage))
    {
        <NotificationBanner Success="m_UpdateSucceeded" Message="m_UpdateMessage" />
    }
</div>
