<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- Copy to App.config and replace CHANGE_ME values for production. -->

    <!-- Central server (Zeron.Server) -->
    <add key="server_enabled" value="true" />
    <add key="server_url" value="https://your-server:5000" />
    <add key="server_api_key" value="CHANGE_ME_MATCH_SERVER_AgentApiKey" />
    <add key="server_hmac_enabled" value="true" />
    <add key="server_heartbeat_interval_ms" value="30000" />

    <!-- ManagedPackage local catalog + optional Server sync -->
    <add key="mp_db_source_file" value="Resource/appdb-windows.db" />
    <add key="mp_repo_temp_path" value="Resource/mp-temp" />
    <add key="mp_catalog_sync_enabled" value="true" />
    <add key="mp_catalog_sync_interval_ms" value="300000" />

    <!-- NetMQ SUB: receive RemoteCommand from Server PUB -->
    <add key="zmq_sub_enabled" value="true" />
    <add key="zmq_sub_addr" value="tcp://your-server:6000" />
    <add key="zmq_sub_api_key" value="CHANGE_ME_MATCH_SERVER_AgentApiKey" />
    <add key="zmq_sub_api_scopes" value="*" />
    <add key="zmq_sub_curve_enabled" value="true" />
    <add key="zmq_sub_curve_server_public_key_file" value="Resource/curve-server.public" />
    <add key="zmq_sub_curve_client_secret_file" value="Resource/curve-client.secret" />

    <!-- Local NetMQ (optional; plaintext for Zeron.Client / tooling) -->
    <add key="zmq_rep_enabled" value="false" />
    <add key="zmq_rep_addr" value="tcp://127.0.0.1:5589" />
    <add key="zmq_rep_api_key" value="CHANGE_ME_LOCAL_API_KEY" />
    <add key="zmq_rep_api_scopes" value="*" />
    <add key="zmq_pub_enabled" value="false" />
    <add key="zmq_pub_addr" value="tcp://127.0.0.1:5588" />

    <!-- Must match Server EncryptionSaltKey / EncryptionIvKey (and ZERON_CRYPT_* env) -->
    <add key="encryption_salt_key" value="CHANGE_ME_SHARED_CRYPT_SALT" />
    <add key="encryption_iv_key" value="CHANGE_ME_SHARED_CRYPT_IV" />

    <!-- Script Host (PowerShell built-in + optional external engines) -->
    <add key="script_powershell_enabled" value="true" />
    <add key="script_powershell_exe" value="powershell.exe" />
    <add key="script_default_timeout_ms" value="300000" />
    <!-- Example external engine (set enabled=true and adjust exe/args):
    <add key="script_engine_pwsh_enabled" value="false" />
    <add key="script_engine_pwsh_exe" value="pwsh" />
    <add key="script_engine_pwsh_args" value="-NoProfile -File {scriptPath} {arguments}" />
    <add key="script_engine_pwsh_platforms" value="windows,linux,macos" />
    <add key="script_engine_pwsh_inline_mode" value="tempfile" />
    <add key="script_engine_pwsh_display" value="PowerShell 7" />
    -->

    <!-- Optional ScriptEventBridge listener (observe bus events; cannot gate sync/install) -->
    <add key="script_event_listener_enabled" value="false" />
    <add key="script_event_listener_exe" value="powershell.exe" />
    <add key="script_event_listener_args" value="-NoProfile -ExecutionPolicy Bypass -File Resource/script-event-listener.sample.ps1" />
    <add key="script_event_listener_restart_ms" value="3000" />

    <!-- Optional agent-side SMTP (MailerServer) -->
    <add key="mail_enabled" value="false" />
    <add key="mail_host" value="smtp.example.com" />
    <add key="mail_port" value="587" />
    <add key="mail_user_login" value="" />
    <add key="mail_user_password" value="" />
    <add key="mail_sender_name" value="Zeron Agent" />
    <add key="mail_sender_address" value="zeron-agent@example.com" />
    <add key="mail_recipients_administrator" value="ops@example.com" />
    <add key="mail_enable_ssl" value="true" />
  </appSettings>
</configuration>
