@using System.Reflection
@using Zeron.Server.ZInterfaces
@inject IRazorComponentAssemblyProvider RazorAssemblies

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(App).Assembly"
            AdditionalAssemblies="RazorAssemblies.GetAdditionalAssemblies()">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <p class="denied">You are not authorized to access this page.</p>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
    </Router>
</CascadingAuthenticationState>
