@page "/agents"
@rendermode InteractiveServer
@using Zeron.Server.Data.Entities
@using Zeron.Server.ZCore
@using Zeron.Server.ZServers
@using Zeron.ZCore.Type
@attribute [Authorize(Policy = ServerPolicies.ViewerOrAbove)]
@inject AgentManagerServer AgentManager
@inject AgentDiagnosticServer AgentDiagnosticServer
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@implements IAsyncDisposable

<div class="page-header">
    <div>
        <h1>Agents</h1>
        <p>Registered Windows agents, connection diagnostics, and heartbeat status.</p>
    </div>
    <button class="btn btn-secondary" @onclick="ReloadAsync">Refresh</button>
</div>

<div class="panel">
    @if (m_Agents.Count == 0)
    {
        <p class="error">No agents registered yet. Start <code>Zeron.Demand</code> and ensure <code>server_enabled=true</code>. See Docs/agent-connection.md for troubleshooting.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Agent Key</th>
                    <th>Machine</th>
                    <th>Status</th>
                    <th>Connection</th>
                    <th>Last Heartbeat</th>
                    <th>Diagnostic</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (AgentEntity agent in m_Agents)
                {
                    AgentDiagnosticType? diagnostic = m_Diagnostics.FirstOrDefault(item => item.AgentKey == agent.AgentKey);

                    <tr>
                        <td>@agent.AgentKey</td>
                        <td>@agent.MachineName</td>
                        <td><span class="status @agent.Status">@agent.Status</span></td>
                        <td>
                            @if (diagnostic != null)
                            {
                                <span class="status @diagnostic.ConnectionState">@diagnostic.ConnectionState</span>
                            }
                        </td>
                        <td>@UiFormatServer.FormatHeartbeat(agent.LastHeartbeatAt)</td>
                        <td><small>@(diagnostic?.DiagnosticMessage ?? "-")</small></td>
                        <td><a href="@($"/agents/{agent.AgentKey}")">Details</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (m_Diagnostics.Any(item => item.ConnectionState is "offline" or "stale" or "never_seen"))
{
    <div class="panel">
        <h2>Connection Troubleshooting</h2>
        @foreach (AgentDiagnosticType diagnostic in m_Diagnostics.Where(item => item.ConnectionState is not "healthy" and not "disabled"))
        {
            <div class="timeline-item">
                <strong>@diagnostic.AgentKey</strong>
                <small>@diagnostic.ConnectionState</small>
                <div>@diagnostic.DiagnosticMessage</div>
                <div><em>@diagnostic.RecommendedAction</em></div>
            </div>
        }
    </div>
}
