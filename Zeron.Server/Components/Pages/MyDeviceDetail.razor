@page "/my-devices/{AgentKey}"
@rendermode InteractiveServer
@using Zeron.Server.Data.Entities
@using Zeron.Server.ZServers
@using Zeron.ZCore.Type
@attribute [Authorize(Policy = ServerPolicies.DeviceOwnerOrStaff)]
@inject DevicePortalServer PortalServer
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="page-header">
    <div>
        <h1>@(m_Device?.MachineName ?? AgentKey)</h1>
        <p>Read-only Zeron.Demand status for your bound agent.</p>
    </div>
    <div class="actions">
        <a class="btn btn-secondary" href="/my-devices">Back</a>
        <button class="btn btn-secondary" @onclick="ReloadAsync" disabled="@m_IsBusy">Refresh</button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(m_Error))
{
    <p class="error">@m_Error</p>
}
else if (m_Device == null)
{
    <p class="error">Device not found or not bound to your account.</p>
}
else
{
    <div class="cards">
        <div class="card"><span>Status</span><strong><span class="status @m_Device.Status">@m_Device.Status</span></strong></div>
        <div class="card"><span>Version</span><strong>@(m_Device.Version ?? "-")</strong></div>
        <div class="card"><span>IP</span><strong>@(m_Device.IpAddress ?? "-")</strong></div>
        <div class="card"><span>Last Heartbeat</span><strong>@(m_Device.LastHeartbeatAt?.ToLocalTime().ToString("g") ?? "-")</strong></div>
        <div class="card"><span>Install Queue</span><strong>@m_Device.InstallQueueCount</strong></div>
        <div class="card"><span>Install Running</span><strong>@(m_Device.InstallRunning ? "yes" : "no")</strong></div>
        <div class="card"><span>Scheduler Tasks</span><strong>@m_Device.SchedulerTaskCount</strong></div>
        <div class="card"><span>Uptime (sec)</span><strong>@m_Device.UptimeSeconds</strong></div>
    </div>

    <div class="panel">
        <h2>Recent Install Events</h2>
        @if (m_Events.Count == 0)
        {
            <p class="muted">No recent install events.</p>
        }
        else
        {
            @foreach (EventEntity evt in m_Events)
            {
                <div class="timeline-item">
                    <strong>@evt.Topic</strong>
                    <small>@evt.ReceivedAt.ToLocalTime()</small>
                    <div>@evt.Payload</div>
                </div>
            }
        }
    </div>
}
