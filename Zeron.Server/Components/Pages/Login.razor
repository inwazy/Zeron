@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]

<div class="login-page">
    <div class="login-card">
        <div class="brand" style="margin-bottom: 1.5rem;">
            <span class="brand-mark">Z</span>
            <div>
                <strong>Zeron Server</strong>
                <small>Dashboard Login</small>
            </div>
        </div>

        <form method="post" action="/account/login">
            <AntiforgeryToken />
            <div class="form-grid">
                <label>
                    Username
                    <input name="username" required autocomplete="username" />
                    @if (!string.IsNullOrWhiteSpace(m_UsernameError))
                    {
                        <p class="field-error">@m_UsernameError</p>
                    }
                </label>
                <label>
                    Password
                    <input name="password" type="password" required autocomplete="current-password" />
                    @if (!string.IsNullOrWhiteSpace(m_PasswordError))
                    {
                        <p class="field-error">@m_PasswordError</p>
                    }
                </label>
                <button class="btn" type="submit">Sign In</button>
            </div>
        </form>

        @if (!string.IsNullOrWhiteSpace(m_Error))
        {
            <NotificationBanner Success="false" Message="m_Error" />
        }
    </div>
</div>
