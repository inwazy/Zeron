@page "/agents/{AgentKey}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Zeron.Server.Data.Entities
@using Zeron.Server.ZCore
@using Zeron.Server.ZServers
@using Zeron.ZCore.Type
@attribute [Authorize(Policy = ServerPolicies.ViewerOrAbove)]
@inject AgentManagerServer AgentManager
@inject AgentDiagnosticServer AgentDiagnosticServer
@inject EventIngestorServer EventIngestor

<div class="page-header">
    <div>
        <h1>@AgentKey</h1>
        <p>Agent details, heartbeat history, and recent events.</p>
    </div>
    <AuthorizeView Roles="@ServerRoles.Admin">
        <Authorized>
            <div class="actions">
                @if (m_Agent?.Status != "disabled")
                {
                    <button class="btn btn-danger" @onclick="DisableAgentAsync">Disable Agent</button>
                }
                else
                {
                    <button class="btn btn-secondary" @onclick="EnableAgentAsync">Enable Agent</button>
                }
            </div>
        </Authorized>
    </AuthorizeView>
</div>

@if (m_Agent == null)
{
    <p class="error">Agent not found.</p>
}
else
{
    <div class="cards">
        <div class="card"><span>Status</span><strong><span class="status @m_Agent.Status">@m_Agent.Status</span></strong></div>
        <div class="card"><span>Connection</span><strong><span class="status @m_Diagnostic?.ConnectionState">@(m_Diagnostic?.ConnectionState ?? "-")</span></strong></div>
        <div class="card"><span>Machine</span><strong>@m_Agent.MachineName</strong></div>
        <div class="card"><span>IP</span><strong>@m_Agent.IpAddress</strong></div>
        <div class="card"><span>Last Heartbeat</span><strong>@m_Agent.LastHeartbeatAt.ToLocalTime()</strong></div>
    </div>

    @if (m_Diagnostic != null)
    {
        <div class="panel">
            <h2>Connection Diagnostic</h2>
            <p>@m_Diagnostic.DiagnosticMessage</p>
            <p><em>@m_Diagnostic.RecommendedAction</em></p>
            @if (m_Diagnostic.HasOpenOfflineAlert)
            {
                <p class="error">An open offline alert exists for this agent.</p>
            }
        </div>
    }

    <div class="panel">
        <h2>Script Engines</h2>
        @if (m_ScriptEngines.Count == 0)
        {
            <p>No script engine capabilities reported yet.</p>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Platforms</th>
                        <th>Available</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (ScriptEngineInfoType engine in m_ScriptEngines)
                    {
                        <tr>
                            <td>@engine.Id</td>
                            <td>@engine.DisplayName</td>
                            <td>@string.Join(", ", engine.Platforms)</td>
                            <td>@(engine.Available ? "yes" : "no")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="panel">
        <h2>Heartbeat History</h2>
        @if (m_Heartbeats.Count == 0)
        {
            <p>No heartbeat records yet.</p>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Reported At</th>
                        <th>Uptime</th>
                        <th>Install Queue</th>
                        <th>Install Running</th>
                        <th>Scheduler Tasks</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (AgentHeartbeatEntity heartbeat in m_Heartbeats)
                    {
                        <tr>
                            <td>@heartbeat.ReportedAt.ToLocalTime()</td>
                            <td>@heartbeat.UptimeSeconds s</td>
                            <td>@heartbeat.InstallQueueCount</td>
                            <td>@heartbeat.InstallRunning</td>
                            <td>@heartbeat.SchedulerTaskCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="panel">
        <h2>Recent Events</h2>
        @foreach (EventEntity evt in m_Events)
        {
            <div class="timeline-item">
                <strong>@evt.Topic</strong>
                <small>@evt.ReceivedAt.ToLocalTime()</small>
                <div>@evt.Payload</div>
            </div>
        }
    </div>
}
