@page "/packages/catalog"
@rendermode InteractiveServer
@using Zeron.Server.ZServers
@using Zeron.ZCore.Type
@attribute [Authorize(Policy = ServerPolicies.ViewerOrAbove)]
@inject ManagedPackageCatalogServer CatalogServer
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="page-header">
    <div>
        <h1>Package Catalog</h1>
        <p>Central ManagedPackage definitions synced to Demand agents. Local Demand overrides are preserved.</p>
    </div>
    <div class="actions">
        <a class="btn btn-secondary" href="/packages">Deploys</a>
        <a class="btn btn-secondary" href="/packages/sync-health">Sync Health</a>
        <AuthorizeView Roles="@($"{ServerRoles.Admin},{ServerRoles.Operator}")">
            <Authorized>
                <a class="btn" href="/packages/deploy">Deploy Package</a>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

<AuthorizeView Roles="@($"{ServerRoles.Admin},{ServerRoles.Operator}")">
    <Authorized>
        <div class="panel">
            <h2>@(m_EditId == null ? "Create Package" : "Edit Package")</h2>
            <div class="form-grid form-grid-wide">
                <label>
                    Name
                    <InputText @bind-Value="m_Form.Name" disabled="@(m_EditId != null)" />
                </label>
                <label>
                    Enabled
                    <InputCheckbox @bind-Value="m_Form.IsEnabled" />
                </label>
                <label>
                    URL x86
                    <InputText @bind-Value="m_Form.Urlx86" />
                </label>
                <label>
                    URL x64
                    <InputText @bind-Value="m_Form.Urlx64" />
                </label>
                <label>
                    Install Cmd x86
                    <InputText @bind-Value="m_Form.CmdInstallx86" />
                </label>
                <label>
                    Install Cmd x64
                    <InputText @bind-Value="m_Form.CmdInstallx64" />
                </label>
                <label>
                    Uninstall Cmd x86
                    <InputText @bind-Value="m_Form.CmdUnInstallx86" />
                </label>
                <label>
                    Uninstall Cmd x64
                    <InputText @bind-Value="m_Form.CmdUnInstallx64" />
                </label>
                <label>
                    SHA-256 x86
                    <InputText @bind-Value="m_Form.Sha256x86" />
                    <small class="muted">Optional. Lowercase hex digest verified after download.</small>
                </label>
                <label>
                    SHA-256 x64
                    <InputText @bind-Value="m_Form.Sha256x64" />
                </label>
                <label>
                    Script Engine
                    <InputText @bind-Value="m_Form.ScriptEngine" />
                    <small class="muted">Script Host engine id for before/after hooks (default powershell).</small>
                </label>
                <label class="form-span">
                    Install Before Script
                    <InputTextArea @bind-Value="m_Form.ScriptInstallBefore" rows="5" />
                    <small class="muted">Optional. Runs via Script Host before install.</small>
                </label>
                <label class="form-span">
                    Install After Script
                    <InputTextArea @bind-Value="m_Form.ScriptInstallAfter" rows="5" />
                </label>
                <label class="form-span">
                    Uninstall Before Script
                    <InputTextArea @bind-Value="m_Form.ScriptUnInstallBefore" rows="5" />
                </label>
                <label class="form-span">
                    Uninstall After Script
                    <InputTextArea @bind-Value="m_Form.ScriptUnInstallAfter" rows="5" />
                </label>
                <div class="actions form-span">
                    <LoadingButton CssClass="btn"
                                    IsLoading="@m_IsBusy"
                                    OnClick="SaveAsync">
                        @(m_EditId == null ? "Create" : "Save")
                    </LoadingButton>
                    @if (m_EditId != null)
                    {
                        <LoadingButton CssClass="btn btn-secondary"
                                        Text="Cancel"
                                        IsLoading="@m_IsBusy"
                                        OnClick="CancelEdit" />
                    }
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(m_Message))
            {
                <NotificationBanner Success="m_Succeeded" Message="m_Message" />
            }
        </div>
    </Authorized>
</AuthorizeView>

<div class="panel">
    <div class="panel-header">
        <h2>Catalog</h2>
            <LoadingButton CssClass="btn btn-secondary"
                            Text="Refresh"
                            IsLoading="@m_IsBusy"
                            OnClick="ReloadAsync" />
    </div>

    @if (m_Packages.Count == 0)
    {
        <p class="muted">No packages in the Server catalog yet.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Engine</th>
                    <th>Scripts</th>
                    <th>URL x64</th>
                    <th>Updated</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (ManagedPackageInfoType package in m_Packages)
                {
                    <tr>
                        <td><code>@package.Name</code></td>
                        <td>
                            <span class="status @(package.IsEnabled ? "online" : "offline")">
                                @(package.IsEnabled ? "enabled" : "disabled")
                            </span>
                        </td>
                        <td><code>@(string.IsNullOrWhiteSpace(package.ScriptEngine) ? "powershell" : package.ScriptEngine)</code></td>
                        <td>@DescribeScripts(package)</td>
                        <td class="muted">@(string.IsNullOrWhiteSpace(package.Urlx64) ? "-" : package.Urlx64)</td>
                        <td>@(package.UpdatedAt?.ToLocalTime().ToString("g") ?? "-")</td>
                        <td>
                            <div class="actions">
                                <LoadingButton CssClass="btn btn-secondary"
                                                Text="History"
                                                IsLoading="@m_IsBusy"
                                                OnClick="() => ShowHistoryAsync(package)" />
                                <AuthorizeView Roles="@($"{ServerRoles.Admin},{ServerRoles.Operator}")">
                                    <Authorized>
                                        <LoadingButton CssClass="btn btn-secondary"
                                                        Text="Edit"
                                                        IsLoading="@m_IsBusy"
                                                        OnClick="() => BeginEdit(package)" />
                                        <LoadingButton CssClass="btn btn-danger"
                                                        Text="Delete"
                                                        IsLoading="@m_IsBusy"
                                                        OnClick="() => DeleteAsync(package)" />
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (m_HistoryPackage != null)
{
    <div class="panel">
        <div class="panel-header">
            <h2>History: <code>@m_HistoryPackage.Name</code></h2>
            <LoadingButton CssClass="btn btn-secondary"
                            Text="Close"
                            IsLoading="@m_IsBusy"
                            OnClick="CloseHistory" />
        </div>

        @if (!string.IsNullOrWhiteSpace(m_HistoryMessage))
        {
            <NotificationBanner Success="m_HistorySucceeded" Message="m_HistoryMessage" />
        }

        @if (m_Versions.Count == 0)
        {
            <p class="muted">No versions recorded for this package.</p>
        }
        else
        {
            <div class="form-grid form-grid-wide" style="margin-bottom: 1rem;">
                <label>
                    Compare left
                    <InputSelect @bind-Value="m_DiffLeftKey">
                        <option value="current">current (live)</option>
                        @foreach (ManagedPackageVersionInfoType version in m_Versions.OrderBy(item => item.VersionNumber))
                        {
                            <option value="@version.VersionNumber">v@version.VersionNumber (@version.ChangeKind)</option>
                        }
                    </InputSelect>
                </label>
                <label>
                    Compare right
                    <InputSelect @bind-Value="m_DiffRightKey">
                        <option value="current">current (live)</option>
                        @foreach (ManagedPackageVersionInfoType version in m_Versions.OrderBy(item => item.VersionNumber))
                        {
                            <option value="@version.VersionNumber">v@version.VersionNumber (@version.ChangeKind)</option>
                        }
                    </InputSelect>
                </label>
                <label class="checkbox-row">
                    <InputCheckbox @bind-Value="m_DiffChangedOnly" />
                    Show changed fields only
                </label>
                <div class="actions">
                    <LoadingButton CssClass="btn"
                                    Text="Compare"
                                    IsLoading="@m_IsBusy"
                                    OnClick="CompareAsync" />
                    @if (m_Diff != null)
                    {
                        <LoadingButton CssClass="btn btn-secondary"
                                        Text="Clear Diff"
                                        IsLoading="@m_IsBusy"
                                        OnClick="ClearDiff" />
                    }
                </div>
            </div>

            @if (m_Diff != null)
            {
                <div class="panel-header" style="margin-bottom: 0.75rem;">
                    <h2>Diff: @m_Diff.LeftLabel → @m_Diff.RightLabel</h2>
                    <span class="muted">@m_Diff.ChangedCount field(s) changed</span>
                </div>

                @if (VisibleDiffFields.Count == 0)
                {
                    <p class="muted">No differences in the selected filter.</p>
                }
                else
                {
                    <table class="diff-table">
                        <thead>
                            <tr>
                                <th>Field</th>
                                <th>@m_Diff.LeftLabel</th>
                                <th>@m_Diff.RightLabel</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (ManagedPackageVersionDiffFieldType field in VisibleDiffFields)
                            {
                                <tr class="@(field.Changed ? "diff-changed" : "")">
                                    <td><code>@field.Field</code></td>
                                    <td><pre class="diff-value">@(string.IsNullOrEmpty(field.Left) ? "∅" : field.Left)</pre></td>
                                    <td><pre class="diff-value">@(string.IsNullOrEmpty(field.Right) ? "∅" : field.Right)</pre></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }

            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>When</th>
                        <th>Kind</th>
                        <th>Actor</th>
                        <th>Enabled</th>
                        <th>Engine</th>
                        <th>Scripts</th>
                        <th>URL x64</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (ManagedPackageVersionInfoType version in m_Versions)
                    {
                        <tr>
                            <td>@version.VersionNumber</td>
                            <td>@version.CreatedAt.ToLocalTime().ToString("g")</td>
                            <td>
                                <span class="status @VersionKindClass(version.ChangeKind)">@version.ChangeKind</span>
                                @if (version.RestoredFromVersion.HasValue)
                                {
                                    <small class="muted"> ← v@version.RestoredFromVersion</small>
                                }
                            </td>
                            <td>@(version.ActorUsername ?? "-")</td>
                            <td>
                                <span class="status @(version.IsEnabled ? "online" : "offline")">
                                    @(version.IsEnabled ? "enabled" : "disabled")
                                </span>
                            </td>
                            <td><code>@(string.IsNullOrWhiteSpace(version.ScriptEngine) ? "powershell" : version.ScriptEngine)</code></td>
                            <td>@DescribeScripts(version)</td>
                            <td class="muted">@(string.IsNullOrWhiteSpace(version.Urlx64) ? "-" : version.Urlx64)</td>
                            <td>
                                <div class="actions">
                                    <LoadingButton CssClass="btn btn-secondary"
                                                    Text="Diff"
                                                    IsLoading="@m_IsBusy"
                                                    OnClick="() => CompareToCurrentAsync(version.VersionNumber)" />
                                    <AuthorizeView Roles="@($"{ServerRoles.Admin},{ServerRoles.Operator}")">
                                        <Authorized>
                                            <LoadingButton CssClass="btn btn-secondary"
                                                            Text="Restore"
                                                            IsLoading="@m_IsBusy"
                                                            OnClick="() => RollbackAsync(version.VersionNumber)" />
                                        </Authorized>
                                    </AuthorizeView>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}
