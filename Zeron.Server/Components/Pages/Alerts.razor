@page "/alerts"
@rendermode InteractiveServer
@using Zeron.Server.Data.Entities
@using Zeron.Server.ZCore
@using Zeron.Server.ZCore.Type
@using Zeron.Server.ZServers
@attribute [Authorize(Policy = ServerPolicies.ViewerOrAbove)]
@inject AlertRuleServer AlertRuleServer
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@implements IAsyncDisposable

<div class="page-header">
    <div>
        <h1>Alerts</h1>
        <p>Agent offline and other operational alerts.</p>
    </div>
    <div class="actions">
        <LoadingButton CssClass="btn btn-secondary"
                        Text="All"
                        IsLoading="@m_IsBusy"
                        OnClick="() => LoadAlertsAsync(null)" />
        <LoadingButton CssClass="btn btn-secondary"
                        Text="Open"
                        IsLoading="@m_IsBusy"
                        OnClick="() => LoadAlertsAsync(AlertStatusesType.Open)" />
        <LoadingButton CssClass="btn btn-secondary"
                        Text="Resolved"
                        IsLoading="@m_IsBusy"
                        OnClick="() => LoadAlertsAsync(AlertStatusesType.Resolved)" />
    </div>
</div>

<div class="panel">
    <div class="panel-header">
        <h2>Results</h2>
        <div class="actions">
            <small class="muted">@PageSummary</small>
            <LoadingButton CssClass="btn btn-secondary"
                            Text="Previous"
                            IsLoading="@m_IsBusy"
                            Disabled="@(m_PageIndex == 0)"
                            OnClick="GoPrevPageAsync" />
            <LoadingButton CssClass="btn btn-secondary"
                            Text="Next"
                            IsLoading="@m_IsBusy"
                            Disabled="@(!m_HasNextPage)"
                            OnClick="GoNextPageAsync" />
        </div>
    </div>

    @if (m_PageRows.Count == 0)
    {
        <p>No alerts found.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Severity</th>
                    <th>Title</th>
                    <th>Agent</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (AlertEntity alert in m_PageRows)
                {
                    <tr>
                        <td><span class="status @alert.Severity">@alert.Severity</span></td>
                        <td>
                            <strong>@alert.Title</strong>
                            <div><small>@alert.Message</small></div>
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(alert.AgentKey))
                            {
                                <a href="@($"/agents/{alert.AgentKey}")">@alert.AgentKey</a>
                            }
                        </td>
                        <td><span class="status @alert.Status">@alert.Status</span></td>
                        <td>@alert.CreatedAt.ToLocalTime()</td>
                        <td>
                            @if (alert.Status == AlertStatusesType.Open)
                            {
                                <AuthorizeView Roles="@($"{ServerRoles.Admin},{ServerRoles.Operator}")">
                                    <Authorized>
                                        <LoadingButton CssClass="btn-link"
                                                        Text="Acknowledge"
                                                        IsLoading="@m_IsBusy"
                                                        OnClick="() => AcknowledgeAsync(alert.Id)" />
                                    </Authorized>
                                </AuthorizeView>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
