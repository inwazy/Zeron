@page "/account/change-password"
@layout EmptyLayout
@attribute [Authorize(Policy = ServerPolicies.ViewerOrAbove)]

<div class="login-page">
    <div class="login-card">
        <div class="brand" style="margin-bottom: 1.5rem;">
            <span class="brand-mark">Z</span>
            <div>
                <strong>Change Password</strong>
                <small>@(m_IsRequired ? "Required before continuing" : "Update your account password")</small>
            </div>
        </div>

        @if (m_IsRequired)
        {
            <p class="warning-text">You must set a new password before using the dashboard.</p>
        }

        <form method="post" action="/account/change-password">
            <div class="form-grid">
                <label>
                    Current Password
                    <input name="currentPassword" type="password" required autocomplete="current-password" />
                </label>
                <label>
                    New Password
                    <input name="newPassword" type="password" required minlength="6" autocomplete="new-password" />
                </label>
                <label>
                    Confirm New Password
                    <input name="confirmPassword" type="password" required minlength="6" autocomplete="new-password" />
                </label>
                <button class="btn" type="submit">Update Password</button>
            </div>
        </form>

        @if (!string.IsNullOrWhiteSpace(m_Error))
        {
            <p class="error">@m_Error</p>
        }

        @if (!m_IsRequired)
        {
            <p style="margin-top: 1rem;"><a href="/">Back to Dashboard</a></p>
        }
        else
        {
            <form method="post" action="/account/logout" style="margin-top: 1rem;">
                <button class="btn-link" type="submit">Logout</button>
            </form>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "required")]
    public string? Required { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorCode { get; set; }

    private bool m_IsRequired;
    private string? m_Error;

    protected override void OnInitialized()
    {
        m_IsRequired = Required == "1";
        m_Error = ErrorCode switch
        {
            "mismatch" => "New password and confirmation do not match.",
            "current" => "Current password is incorrect.",
            "same" => "New password must be different from the current password.",
            "invalid" => "Unable to update password. Use at least 6 characters.",
            _ => null
        };
    }
}
