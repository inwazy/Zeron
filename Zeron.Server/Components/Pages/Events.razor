@page "/events"
@rendermode InteractiveServer
@using Zeron.Server.Data.Entities
@using Zeron.Server.ZServers
@attribute [Authorize(Policy = ServerPolicies.ViewerOrAbove)]
@inject EventIngestorServer EventIngestor
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@implements IAsyncDisposable

<div class="page-header">
    <div>
        <h1>Events</h1>
        <p>Live timeline of agent-published events.</p>
    </div>
</div>

<div class="panel">
    <div class="form-grid" style="margin-bottom: 1rem; max-width: 100%; grid-template-columns: 1fr 1fr auto;">
        <label>
            Agent Key
            <InputText @bind-Value="m_AgentKey" />
        </label>
        <label>
            Topic
            <InputText @bind-Value="m_Topic" />
        </label>
        <div class="actions" style="align-items: end;">
            <LoadingButton CssClass="btn btn-secondary"
                            Text="Filter"
                            IsLoading="@m_IsBusy"
                            OnClick="ApplyFiltersAsync" />
        </div>
    </div>

    <PagerBar Title="Results"
              Summary="@PageSummary"
              IsLoading="@m_IsBusy"
              HasPrevious="@(m_PageIndex > 0)"
              HasNext="@m_HasNextPage"
              OnPrevious="GoPrevPageAsync"
              OnNext="GoNextPageAsync" />

    @if (m_PageRows.Count == 0)
    {
        <p class="muted">No events found.</p>
    }
    else
    {
        @foreach (EventEntity evt in m_PageRows)
        {
            <div class="timeline-item">
                <strong>@evt.Topic</strong>
                <small>@evt.Agent?.AgentKey · @evt.ReceivedAt.ToLocalTime()</small>
                <div>@evt.Payload</div>
            </div>
        }
    }
</div>
