@page "/schedules/{ScheduleId:guid}"
@rendermode InteractiveServer
@using Zeron.Server.ZServers
@using Zeron.ZCore.Type
@attribute [Authorize(Policy = ServerPolicies.ViewerOrAbove)]
@inject TaskScheduleServer TaskScheduleServer
@inject NavigationManager Navigation

<div class="page-header">
    <div>
        <h1>@(m_Schedule?.Name ?? "Schedule")</h1>
        <p>Cron schedule details and controls.</p>
    </div>
    <div class="actions">
        <AuthorizeView Roles="@($"{ServerRoles.Admin},{ServerRoles.Operator}")">
            <Authorized>
                @if (m_Schedule != null)
                {
                    <LoadingButton CssClass="btn"
                                    Text="Run Now"
                                    IsLoading="@m_IsBusy"
                                    OnClick="RunNowAsync" />
                    @if (m_Schedule.Enabled)
                    {
                        <LoadingButton CssClass="btn btn-secondary"
                                        Text="Disable"
                                        IsLoading="@m_IsBusy"
                                        OnClick="() => SetEnabledAsync(false)" />
                    }
                    else
                    {
                        <LoadingButton CssClass="btn btn-secondary"
                                        Text="Enable"
                                        IsLoading="@m_IsBusy"
                                        OnClick="() => SetEnabledAsync(true)" />
                    }
                }
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="@ServerRoles.Admin">
            <Authorized>
                <LoadingButton CssClass="btn btn-danger"
                                Text="Delete"
                                IsLoading="@m_IsBusy"
                                OnClick="DeleteAsync" />
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@if (m_Schedule == null)
{
    <NotificationBanner Success="false" Message="Schedule not found." />
}
else
{
    <div class="cards">
        <div class="card">
            <span>Status</span>
            <strong>
                <span class="status @(m_Schedule.Enabled ? "online" : "disabled")">
                    @(m_Schedule.Enabled ? "enabled" : "disabled")
                </span>
            </strong>
        </div>
        <div class="card"><span>Cron</span><strong><code>@m_Schedule.Cron</code></strong></div>
        <div class="card"><span>Target API</span><strong>@m_Schedule.TargetApi</strong></div>
        <div class="card"><span>Next Run</span><strong>@(m_Schedule.NextRunAt?.ToLocalTime().ToString("g") ?? "-")</strong></div>
        <div class="card"><span>Last Run</span><strong>@(m_Schedule.LastRunAt?.ToLocalTime().ToString("g") ?? "-")</strong></div>
    </div>

    <div class="panel">
        <h2>Details</h2>
        <table>
            <tbody>
                <tr><th>Description</th><td>@(m_Schedule.Description ?? "-")</td></tr>
                <tr><th>Command</th><td>@(string.IsNullOrWhiteSpace(m_Schedule.Command) ? "-" : m_Schedule.Command)</td></tr>
                <tr><th>Target Type</th><td>@m_Schedule.TargetType</td></tr>
                <tr>
                    <th>Agents</th>
                    <td>
                        @if (m_Schedule.AgentIds is { Count: > 0 })
                        {
                            @string.Join(", ", m_Schedule.AgentIds)
                        }
                        else
                        {
                            <text>-</text>
                        }
                    </td>
                </tr>
                <tr><th>Hostname Pattern</th><td>@(m_Schedule.HostnamePattern ?? "-")</td></tr>
                <tr>
                    <th>Last Task</th>
                    <td>
                        @if (m_Schedule.LastTaskId.HasValue)
                        {
                            <a href="@($"/tasks/{m_Schedule.LastTaskId}")">@m_Schedule.LastTaskId</a>
                        }
                        else
                        {
                            <text>-</text>
                        }
                    </td>
                </tr>
                <tr><th>Created</th><td>@m_Schedule.CreatedAt.ToLocalTime()</td></tr>
                <tr><th>Updated</th><td>@m_Schedule.UpdatedAt.ToLocalTime()</td></tr>
            </tbody>
        </table>
    </div>

    <AuthorizeView Roles="@($"{ServerRoles.Admin},{ServerRoles.Operator}")">
        <Authorized>
            <div class="panel">
                <h2>Edit Schedule</h2>
                <div class="form-grid">
                    <label>
                        Name
                        <InputText @bind-Value="m_Edit.Name" />
                    </label>
                    <label>
                        Description
                        <InputText @bind-Value="m_Edit.Description" />
                    </label>
                    <label>
                        Cron Expression
                        <InputText @bind-Value="m_Edit.Cron" />
                    </label>
                    <label>
                        Target API
                        <InputText @bind-Value="m_Edit.TargetApi" />
                    </label>
                    <label>
                        Command
                        <InputText @bind-Value="m_Edit.Command" />
                    </label>
                    <label>
                        Target Type
                        <InputSelect @bind-Value="m_Edit.TargetType">
                            <option value="all">All Online Agents</option>
                            <option value="agent">Specific Agent</option>
                            <option value="filter">Hostname Filter</option>
                        </InputSelect>
                    </label>
                    @if (m_Edit.TargetType == "agent")
                    {
                        <label>
                            Agent Id
                            <InputText @bind-Value="m_Edit.AgentId" />
                        </label>
                    }
                    @if (m_Edit.TargetType == "filter")
                    {
                        <label>
                            Hostname Pattern
                            <InputText @bind-Value="m_Edit.HostnamePattern" />
                        </label>
                    }
                    <div class="actions">
                        <LoadingButton CssClass="btn"
                                        Text="Save Changes"
                                        IsLoading="@m_IsBusy"
                                        OnClick="SaveAsync" />
                    </div>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>

    @if (!string.IsNullOrWhiteSpace(m_Message))
    {
        <NotificationBanner Success="m_Succeeded" Message="m_Message" />
    }
}
