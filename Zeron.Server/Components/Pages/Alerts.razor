@page "/alerts"
@rendermode InteractiveServer
@using Zeron.Server.Components.Shared
@using Zeron.Server.Data.Entities
@using Zeron.Server.ZCore
@using Zeron.Server.ZCore.Type
@using Zeron.Server.ZInterfaces
@using Zeron.Server.ZServers
@attribute [Authorize(Policy = ServerPolicies.ViewerOrAbove)]
@inject AlertRuleServer AlertRuleServer
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@inject IEnumerable<IAlertRowActionContribution> AlertRowActions
@implements IAsyncDisposable

<PageHeader Title="Alerts" Subtitle="Agent offline and other operational alerts.">
    <FilterChipsBar Options="c_StatusOptions"
                    SelectedValue="@m_StatusFilter"
                    AriaLabel="Alert status filter"
                    IsLoading="@m_IsBusy"
                    OnSelect="SelectStatusFilterAsync" />
</PageHeader>

<div class="panel">
    <PagerBar Title="Results"
              Summary="@PageSummary"
              IsLoading="@m_IsBusy"
              HasPrevious="@(m_PageIndex > 0)"
              HasNext="@m_HasNextPage"
              OnPrevious="GoPrevPageAsync"
              OnNext="GoNextPageAsync" />

    @if (m_PageRows.Count == 0)
    {
        <EmptyState Title="No alerts found"
                    Message="Open and resolved operational alerts matching this filter will appear here." />
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Severity</th>
                    <th>Title</th>
                    <th>Agent</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (AlertEntity alert in m_PageRows)
                {
                    <tr>
                        <td><span class="status @alert.Severity">@alert.Severity</span></td>
                        <td>
                            <strong>@alert.Title</strong>
                            <div><small>@alert.Message</small></div>
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(alert.AgentKey))
                            {
                                <a href="@($"/agents/{alert.AgentKey}")">@alert.AgentKey</a>
                            }
                        </td>
                        <td><span class="status @alert.Status">@alert.Status</span></td>
                        <td>@alert.CreatedAt.ToLocalTime()</td>
                        <td>
                            @foreach (AlertRowAction action in AlertRowActions.SelectMany(contribution => contribution.GetActions(alert)))
                            {
                                <a class="btn-link" href="@action.Href">@action.Text</a>
                            }
                            @if (alert.Status == AlertStatusesType.Open)
                            {
                                <AuthorizeView Roles="@($"{ServerRoles.Admin},{ServerRoles.Operator}")">
                                    <Authorized>
                                        <LoadingButton CssClass="btn-link"
                                                        Text="Acknowledge"
                                                        IsLoading="@m_IsBusy"
                                                        OnClick="() => AcknowledgeAsync(alert.Id)" />
                                    </Authorized>
                                </AuthorizeView>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
