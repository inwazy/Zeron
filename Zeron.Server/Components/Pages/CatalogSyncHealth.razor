@page "/packages/sync-health"
@rendermode InteractiveServer
@using Zeron.Server.ZServers
@using Zeron.ZCore.Type
@attribute [Authorize(Policy = ServerPolicies.ViewerOrAbove)]
@inject CatalogSyncHealthServer SyncHealthServer
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="page-header">
    <div>
        <h1>Catalog Sync Health</h1>
        <p>ManagedPackage catalog sync status across Demand agents. Stale threshold: @m_Summary?.StaleThresholdMinutes min.</p>
    </div>
    <div class="actions">
        <a class="btn btn-secondary" href="/packages/catalog">Catalog</a>
        <LoadingButton CssClass="btn btn-secondary"
                        Text="Refresh"
                        IsLoading="@m_IsBusy"
                        OnClick="ReloadAsync" />
        <AuthorizeView Roles="@($"{ServerRoles.Admin},{ServerRoles.Operator}")">
            <Authorized>
                <LoadingButton CssClass="btn"
                                Text="Push Unhealthy"
                                IsLoading="@m_IsBusy"
                                OnClick="() => PushAsync(onlyUnhealthy: true)" />
                <LoadingButton CssClass="btn btn-secondary"
                                Text="Push All Online"
                                IsLoading="@m_IsBusy"
                                OnClick="() => PushAsync(onlyUnhealthy: false)" />
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(m_Message))
{
    <NotificationBanner Success="m_Succeeded" Message="m_Message" />
}

@if (m_Summary != null)
{
    <div class="cards">
        <div class="card"><span>Healthy</span><strong>@m_Summary.Healthy</strong></div>
        <div class="card"><span>Stale</span><strong>@m_Summary.Stale</strong></div>
        <div class="card"><span>Never Synced</span><strong>@m_Summary.NeverSynced</strong></div>
        <div class="card"><span>Recently Failed</span><strong>@m_Summary.RecentlyFailed</strong></div>
        <div class="card"><span>Offline / Disabled</span><strong>@m_Summary.Offline</strong></div>
    </div>
}

<div class="panel">
    <div class="panel-header">
        <h2>Agents</h2>
        <FilterChipsBar Options="c_SyncFilterOptions"
                        SelectedValue="@m_Filter"
                        AriaLabel="Catalog sync state filter"
                        IsLoading="@m_IsBusy"
                        OnSelect="SelectFilterAsync" />
    </div>

    @if (FilteredAgents.Count == 0)
    {
        <p class="muted">No agents in this filter.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Machine</th>
                    <th>Agent</th>
                    <th>Status</th>
                    <th>Sync</th>
                    <th>Last Sync</th>
                    <th>Age (min)</th>
                    <th>Last Fail</th>
                    <th>Detail</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (CatalogSyncHealthItemType item in FilteredAgents)
                {
                    <tr>
                        <td>@(item.MachineName ?? "-")</td>
                        <td><a href="@($"/agents/{item.AgentKey}")"><code>@item.AgentKey</code></a></td>
                        <td><span class="status @item.Status">@item.Status</span></td>
                        <td><span class="status @item.SyncState">@item.SyncState</span></td>
                        <td>@(item.LastCatalogSyncAt?.ToLocalTime().ToString("g") ?? "-")</td>
                        <td>@(item.AgeMinutes?.ToString() ?? "-")</td>
                        <td>@(item.LastFailedSyncAt?.ToLocalTime().ToString("g") ?? "-")</td>
                        <td class="muted">@item.DiagnosticMessage</td>
                        <td>
                            <AuthorizeView Roles="@($"{ServerRoles.Admin},{ServerRoles.Operator}")">
                                <Authorized>
                                    @if (item.Status == "online")
                                    {
                                        <LoadingButton CssClass="btn btn-secondary"
                                                        Text="Push Sync"
                                                        IsLoading="@m_IsBusy"
                                                        OnClick="() => PushOneAsync(item.AgentKey!)" />
                                    }
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
