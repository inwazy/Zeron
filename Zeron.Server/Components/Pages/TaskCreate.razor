@page "/tasks/create"
@rendermode InteractiveServer
@using Zeron.Server.ZServers
@using Zeron.ZCore.Type
@attribute [Authorize(Policy = ServerPolicies.OperatorOrAbove)]
@inject TaskDispatcherServer TaskDispatcher
@inject NavigationManager Navigation

<div class="page-header">
    <div>
        <h1>Create Task</h1>
        <p>Dispatch a remote API command to selected agents.</p>
    </div>
</div>

<div class="panel">
    <div class="form-grid">
        <label>
            Name
            <InputText @bind-Value="m_Model.Name" />
        </label>
        <label>
            Description
            <InputText @bind-Value="m_Model.Description" />
        </label>
        <label>
            Target API
            <InputText @bind-Value="m_Model.TargetApi" />
        </label>
        <label>
            Command
            <InputText @bind-Value="m_Model.Command" />
        </label>
        <label>
            Target Type
            <InputSelect @bind-Value="m_Model.TargetType">
                <option value="all">All Online Agents</option>
                <option value="agent">Specific Agent</option>
                <option value="filter">Hostname Filter</option>
            </InputSelect>
        </label>
        @if (m_Model.TargetType == "agent")
        {
            <label>
                Agent Id
                <InputText @bind-Value="m_Model.AgentId" />
            </label>
        }
        @if (m_Model.TargetType == "filter")
        {
            <label>
                Hostname Pattern
                <InputText @bind-Value="m_Model.HostnamePattern" />
            </label>
        }
        <div class="actions">
            <button class="btn" @onclick="HandleCreateAsync" disabled="@m_IsSubmitting">Create Task</button>
            <a class="btn btn-secondary" href="/tasks">Cancel</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(m_Error))
    {
        <p class="error">@m_Error</p>
    }
</div>

@code {
    private readonly TaskFormModel m_Model = new();
    private string? m_Error;
    private bool m_IsSubmitting;

    private async Task HandleCreateAsync()
    {
        m_Error = null;
        m_IsSubmitting = true;

        try
        {
            TaskCreateRequestType request = new()
            {
                Name = m_Model.Name,
                Description = m_Model.Description,
                TargetApi = m_Model.TargetApi,
                Command = m_Model.Command,
                TargetType = m_Model.TargetType,
                HostnamePattern = m_Model.HostnamePattern,
                AgentIds = string.IsNullOrWhiteSpace(m_Model.AgentId) ? null : [m_Model.AgentId]
            };

            var task = await TaskDispatcher.CreateTaskAsync(request);
            Navigation.NavigateTo($"/tasks/{task.Id}");
        }
        catch (Exception ex)
        {
            m_Error = ex.Message;
        }
        finally
        {
            m_IsSubmitting = false;
        }
    }

    private sealed class TaskFormModel
    {
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public string TargetApi { get; set; } = "HealthCheck";
        public string Command { get; set; } = "";
        public string TargetType { get; set; } = "all";
        public string? AgentId { get; set; }
        public string? HostnamePattern { get; set; }
    }
}
